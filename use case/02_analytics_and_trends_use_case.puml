@startuml
title Mumbai Crime Analysis & Forecasting System\n<b>Subsystem 1: Crime Analytics & Trends</b>
scale max 780x1050
left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ArrowColor #334155
skinparam ArrowThickness 1.2

skinparam actor {
    BackgroundColor #E2E8F0
    BorderColor #1E293B
    FontSize 11
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    BorderThickness 1.3
    FontSize 11
}

skinparam rectangle {
    BackgroundColor #F8FAFC
    BorderColor #0F172A
    BorderThickness 1.5
    FontSize 12
    FontStyle bold
}

actor "Crime Analyst /\nInvestigator" as Analyst
actor "SQLite Central\nDatabase" as SQLite << System >>

rectangle "Crime Analytics & Trends Subsystem" {
    usecase "UC-EDA-01: View Executive KPI Summary\n(Total Cases, Top Head, Categories)" as UC_KPI
    usecase "UC-EDA-02: Explore Longitudinal Trends\n& Multi-Year Curves" as UC_Trends
    usecase "UC-EDA-03: Analyze Monthly Seasonality\n& Statistical Boxplots" as UC_Season
    usecase "UC-EDA-04: Evaluate Registration vs\nDetection Efficiency" as UC_Detect
    usecase "UC-EDA-05: Filter Records by Year,\nCategory & Legal Domain" as UC_Filter
    usecase "UC-EDA-06: Query Database Records\n(crime_records table)" as UC_Query
    usecase "UC-EDA-07: Render Interactive Visualizations\n(Plotly Graphs)" as UC_Plot
    usecase "UC-EDA-08: Export Filtered Analytics\n(Excel / CSV)" as UC_Export

    UC_Trends ..> UC_Filter : <<include>>
    UC_Season ..> UC_Filter : <<include>>
    UC_Detect ..> UC_Filter : <<include>>
    UC_Filter ..> UC_Query : <<include>>

    UC_Trends ..> UC_Plot : <<include>>
    UC_Season ..> UC_Plot : <<include>>
    UC_Detect ..> UC_Plot : <<include>>

    UC_Export ..> UC_Trends : <<extend>>
}

Analyst --> UC_KPI
Analyst --> UC_Trends
Analyst --> UC_Season
Analyst --> UC_Detect
Analyst --> UC_Export

UC_Query --> SQLite

@enduml
